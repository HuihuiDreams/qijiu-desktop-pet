+      return createFakeElement();
+    },
+  };
+
+  try {
+    const layer = new WeatherParticleLayer(root);
+    layer.sync({ weatherKind: 'rain', intensity: 'heavy' }, { visible: true, pets: [{ x: 100, y: 120, size: 96 }] });
+
+    const prevCounts = layer.particleCounts;
+    layer.sync({ weatherKind: 'rain', intensity: 'heavy' }, { visible: true, pets: [{ x: 100, y: 120, size: 96 }] });
