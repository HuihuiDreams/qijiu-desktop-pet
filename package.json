{
  "name": "desktop-pet",
  "version": "0.8.2",
  "description": "岳清源 & 沈清秋 桌面爱宠",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "test": "node --test",
    "build": "electron-builder",
    "verify:installer": "node scripts/verify-installer.js",
    "verify:signatures": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-signatures.ps1"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.3"
  },
  "build": {
    "appId": "com.deskpet.yueqi-shenjiu",
    "productName": "七九爱宠",
    "artifactName": "desktop-pet-setup-${version}.${ext}",
    "files": [
      "**/*",
      "!docs/**",
      "!test/**",
      "!.github/**",
      "!dist/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "artifactName": "desktop-pet-setup-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "src/assets/icon.icns",
      "category": "public.app-category.utilities",
      "minimumSystemVersion": "12.0",
      "darkModeSupport": true
    },
    "afterPack": "scripts/afterPack.js",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "七九爱宠",
      "uninstallDisplayName": "七九爱宠",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HuihuiDreams",
        "repo": "qijiu-desktop-pet"
      }
    ]
  }
}
