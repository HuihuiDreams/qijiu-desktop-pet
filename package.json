{
  "name": "desktop-pet",
  "version": "0.1.7",
  "description": "岳清源 & 沈清秋 桌面爱宠",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "verify:installer": "node scripts/verify-installer.js",
    "verify:signatures": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-signatures.ps1"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-store": "^10.0.0"
  },
  "build": {
    "appId": "com.deskpet.yueqi-shenjiu",
    "productName": "七九爱宠",
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico",
      "signAndEditExecutable": true
    },
    "afterPack": "scripts/afterPack.js",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "七九爱宠",
      "uninstallDisplayName": "七九爱宠",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HuihuiDreams",
        "repo": "qijiu-desktop-pet"
      }
    ]
  }
}
