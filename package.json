{
  "name": "good-omens-desktop-pet",
  "version": "1.0.0",
  "description": "Good Omens (Crowley & Aziraphale) Desktop Pet / 好兆头桌宠",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "test": "node scripts/run-tests.js",
    "test:integration": "node scripts/run-integration-tests.js",
    "test:all": "node scripts/run-tests.js && node scripts/run-integration-tests.js",
    "check:adrs": "node scripts/check_adrs.js",
    "test:font": "playwright test font.spec.js",
    "test:e2e": "playwright test",
    "qa:electron:smoke": "node tools/playwright-electron-smoke.js",
    "qa:electron:performance": "node tools/measure-electron-performance.js",
    "protect:assets": "node scripts/protect-assets.js",
    "prebuild": "node scripts/protect-assets.js",
    "build": "electron-builder",
    "verify:installer": "node scripts/verify-installer.js",
    "verify:package": "node scripts/verify-package-contents.js",
    "verify:signatures": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-signatures.ps1"
  },
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@playwright/test": "^1.65.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "glob": "^14.0.4",
    "playwright": "^1.65.0"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11"
  },
  "build": {
    "appId": "com.deskpet.good-omens",
    "productName": "GoodOmensDeskPet",
    "artifactName": "good-omens-pet-setup-${version}.${ext}",
    "files": [
      "**/*",
      "!docs/**",
      "!test/**",
      "!.github/**",
      "!.codex/**",
      "!.agents/**",
      "!.claude/**",
      "!.geminirules",
      "!AGENTS.md",
      "!CLAUDE.md",
      "!security-scans/**",
      "!tools/**",
      "!scripts/**",
      "!src/assets/*/*.webp",
      "!src/assets/*/*/*.webp",
      "!push.*",
      "!dist/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "artifactName": "good-omens-pet-setup-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "src/assets/icon.icns",
      "category": "public.app-category.utilities",
      "minimumSystemVersion": "13.0",
      "darkModeSupport": true
    },
    "afterPack": "scripts/afterPack.js",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "好兆头桌宠",
      "uninstallDisplayName": "好兆头桌宠",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HuihuiDreams",
        "repo": "good-omens-desktop-pet"
      }
    ]
  }
}
